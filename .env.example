# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored - never commit real API keys.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: model + generation settings
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# Optional: override the bundled data file locations
# STATIONS_FILE=data/charging_stations.json
# ELEVATION_FILE=data/route_elevation.csv

# Optional: agent behaviour
# MAX_TOOL_ITERATIONS=6
# DEFAULT_SEARCH_RADIUS_KM=25
